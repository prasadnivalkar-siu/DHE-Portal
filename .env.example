CI_ENVIRONMENT = development

app.baseURL = 'http://127.0.0.1:8080/'
app.forceGlobalSecureRequests = false

database.default.hostname = 127.0.0.1
database.default.database = dhe_portal
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.strictOn = true

# Legacy key: migration 000015 imports this as default-vendor. New keys are managed under Administration > Vendors.
# dhe.apiKey =

# Required for encrypted vendor API key storage and reveal. Generate once with php spark key:generate.
# Keep the same encryption key when deploying or restoring encrypted vendor records.
